# OPENAI_API_KEY: Required for OpenAI GPT-5.5 / GPT-4o and DALL-E 3 API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
OPENAI_API_KEY="your_openai_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PREMIUM IMAGE GENERATION KEYS
# Configure these to enable high-quality real image generation
FAL_KEY=""
STABILITY_API_KEY=""

# Adding these enables high-fidelity natural speaking conversations
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
PLAYHT_SECRET_KEY=""
PLAYHT_USER_ID=""
PLAYHT_VOICE_ID=""
